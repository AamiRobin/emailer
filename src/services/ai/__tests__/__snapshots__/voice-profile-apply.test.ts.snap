  "version": 1,
  "tone": "warm, direct",
  "formality": "business-casual",
  "length": "short — a few sentences",
  "vocabulary": "plain words, little jargon",
  "quirks": [
    "opens with a quick acknowledgment",
    "uses dashes for asides"
  ],
  "greetingStyle": "Hi {name},",
  "signoffStyle": "Best,"
}
=== END WRITING VOICE ==="
`;

