{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emailer",
  "version": "0.1.0-beta.3",
  "identifier": "com.amirobin.emailer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Emailer",
        "width": 1400,
        "height": 918,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "splashscreen",
        "title": "Emailer",
        "url": "splashscreen.html",
        "width": 420,
        "height": 300,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'sha256-ka5fJDC6WqCeQtMKBl4z4MfkyFZlddmyWHvmhJNseFk=' 'sha256-Z3Du8nrfS1AJZuAiBe6/aDaV04rs2gNm+ZcmXD51VfY='",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://accounts.google.com https://oauth2.googleapis.com https://gmail.googleapis.com https://www.googleapis.com https://login.microsoftonline.com https://graph.microsoft.com https://www.virustotal.com",
        "frame-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGRkQ2N0Q4MEQ2REQ4NzQKUldSMDJHME4yR2Y5aitCbDRrei9GNE5qa3g4T0dwd1ZGUWVIZnc4ZUlHaFNOZ1ZLZjFGd0tsbGUK",
      "endpoints": [
        "https://github.com/AamiRobin/emailer/releases/download/channels/latest-stable.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "mailto"
        ]
      }
    }
  }
}
